# Per-app env template — copy to .env.prod / .env.dev / .env.preview
# and adjust values for each environment. chmod 600 before deploying.
# Do NOT place this in the root .env — that file is for Caddy vars only.

DATABASE_URL=sqlite:///app/kartoteka.db?mode=rwc
# Generate a random 32+ char secret for each environment independently:
# openssl rand -base64 32
OAUTH_SIGNING_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING
PUBLIC_BASE_URL=https://kartoteka.example.com
# Comma-separated CIDRs (or bare IPs) of reverse proxies whose
# X-Forwarded-For may be believed by the /cal rate limiter.
# Unset or empty = trust nothing: every request is keyed on its peer address, so
# all clients behind the proxy share one bucket (burst 20, +1 per 3 s).
# For the compose Caddy setup use that network's subnet, e.g.
#   docker network inspect kartoteka_app -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# TRUSTED_PROXIES=172.18.0.0/16
APP_ENV=production
BIND_ADDR=0.0.0.0:3000
RUST_LOG=info
